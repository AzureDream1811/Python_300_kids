   "source": [
    "def check_number(n):\n",
    "    if n > 0:\n",
    "        return 'The number is positive.'\n",
    "    return 'The number is negative' if n < 0 else 'The number is zero'\n",
    "        \n",
    "print(check_number(10))\n",
    "print(check_number(-10))\n",
    "print(check_number(0))"
   ]
  }
